{
  "expo": {
    "name": "KC Paan POS",
    "slug": "kcpaan-inventory",
    "scheme": "kcpaanpos",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kcpaan.pos"
    },
    "android": {
      "package": "com.kcpaan.pos",
      "versionCode": 12,
      "adaptiveIcon": {
        "backgroundColor": "#0F7B5A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "KC Paan uses the camera only to recognise staff faces for clocking in. Photos are never saved or uploaded.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "apiUrl": "https://kcpaan-inventory-api.onrender.com",
      "eas": {
        "projectId": ""
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 8000
    }
  }
}